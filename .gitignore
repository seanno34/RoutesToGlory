.DS_Store

# ---------------------------------------------------------------------------
# Unity (apps/unity-poc) — generated/machine-specific; regenerated on open
# ---------------------------------------------------------------------------
apps/unity-poc/[Ll]ibrary/
apps/unity-poc/[Tt]emp/
apps/unity-poc/[Oo]bj/
apps/unity-poc/[Bb]uild/
apps/unity-poc/[Bb]uilds/
apps/unity-poc/[Ll]ogs/
apps/unity-poc/[Uu]ser[Ss]ettings/
apps/unity-poc/[Mm]emoryCaptures/
apps/unity-poc/[Rr]ecordings/

# Asset meta files for ignored folders must not be committed
apps/unity-poc/[Aa]ssets/AssetStoreTools*
apps/unity-poc/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Autogenerated IDE / build tool files
apps/unity-poc/.vs/
apps/unity-poc/.vsconfig
apps/unity-poc/.gradle/
apps/unity-poc/ExportedObj/
apps/unity-poc/*.csproj
apps/unity-poc/*.unityproj
apps/unity-poc/*.sln
apps/unity-poc/*.suo
apps/unity-poc/*.tmp
apps/unity-poc/*.user
apps/unity-poc/*.userprefs
apps/unity-poc/*.pidb
apps/unity-poc/*.booproj
apps/unity-poc/*.svd
apps/unity-poc/*.pdb
apps/unity-poc/*.mdb
apps/unity-poc/*.opendb
apps/unity-poc/*.VC.db

# Crashlytics / Unity crash reports
apps/unity-poc/sysinfo.txt
apps/unity-poc/crashlytics-build.properties

# Addressables / build reports
apps/unity-poc/[Aa]ssets/[Ss]treamingAssets/aa.meta
apps/unity-poc/[Aa]ssets/[Ss]treamingAssets/aa/*

# Cesium ion access tokens are per-developer SECRETS — never commit them.
# Cesium regenerates these server assets when you connect to ion.
apps/unity-poc/Assets/CesiumSettings/Resources/CesiumIonServers/*.asset
apps/unity-poc/Assets/CesiumSettings/Resources/CesiumIonServers/*.asset.meta
