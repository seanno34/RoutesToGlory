# Routes to Glory API — production / SPanel
# Copy to .env in this same folder (apps/api/) on the server.
# Do NOT put this file inside public_html.

MYSQL_HOST=localhost
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ventures_rtg_test
MYSQL_PORT=3306

PORT=3001

# Used when seeding worlds — snaps sites to real drivable roads (pk. token)
MAPBOX_ACCESS_TOKEN=pk.your_token_here
