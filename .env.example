# Routes to Glory — local development

# MySQL (matches other 8082ventures apps)
MYSQL_HOST=localhost
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ventures_rtg_test
MYSQL_PORT=3306

# Or a single connection string:
# DATABASE_URL=mysql://user:password@localhost:3306/ventures_rtg_test

# API
PORT=3001

# Web (apps/web)
VITE_API_BASE=http://localhost:3001/api
VITE_MAPBOX_TOKEN=your_mapbox_token_here
